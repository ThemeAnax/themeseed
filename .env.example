# themeseed — local development / integration-test configuration.
# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# NOTE: normal end-user configuration does NOT live here. Sites you seed are
# stored in ~/.themeseed/sites.json via `themeseed add-site`. The variables
# below only exist so the repo's own e2e suite can find a disposable CMS.

# --- Ghost integration-test target -------------------------------------------
# A throwaway Ghost instance the e2e suite is allowed to create and delete
# posts in. Never point this at production.
GHOST_TEST_BLOG_ENDPOINT=http://localhost:2368
# Ghost Admin API key, in "<id>:<hex secret>" form.
# Ghost Admin -> Settings -> Integrations -> Add custom integration.
GHOST_TEST_BLOG_KEY=

# Optional: absolute path to the Ghost install's themes directory. When set,
# analyzeTheme() reads the active theme's .hbs sources directly, which is far
# more accurate than probing rendered HTML. Ghost's Admin API /themes/ endpoint
# rejects API-token auth, so there is no remote equivalent.
# GHOST_THEMES_DIR=/path/to/ghost/content/themes

# --- Image sources (all optional) --------------------------------------------
# Stock provider: "unsplash" or "pexels". Defaults to whichever key is present.
# THEMESEED_STOCK_PROVIDER=unsplash
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=

# Directory scanned by the "local" image source.
# THEMESEED_LOCAL_IMAGE_DIR=./fixtures/images

# AI image source. Five adapters ship; whichever key is present is used, unless
# THEMESEED_AI_IMAGE_ADAPTER names one explicitly.
#   openai     OPENAI_API_KEY   OpenAI Images API
#   grok       XAI_API_KEY      xAI grok-imagine-image
#   gemini     GOOGLE_API_KEY   Google Gemini image models — needs billing enabled
#                               on the project, or every call returns 429 instantly
#   fal        FAL_KEY          fal.ai hosted models, key is "<id>:<secret>"
#   procedural (no key)         local placeholder art — NOT AI, labelled as such
# THEMESEED_AI_IMAGE_ADAPTER=grok
# Override the model an adapter uses (e.g. gemini-3-pro-image, fal-ai/flux/dev):
# THEMESEED_AI_IMAGE_MODEL=
# OPENAI_API_KEY=
# XAI_API_KEY=
# GOOGLE_API_KEY=
# FAL_KEY=

# --- Content engine (optional) -----------------------------------------------
# "template" (default, offline, deterministic) or "anthropic" (higher quality
# prose, requires a key). The MCP host's own model is used when available.
# THEMESEED_CONTENT_ENGINE=template
# ANTHROPIC_API_KEY=
