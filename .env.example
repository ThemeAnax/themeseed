# themeseed — local development / integration-test configuration.
# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# NOTE: normal end-user configuration does NOT live here. Sites you seed are
# stored in ~/.themeseed/sites.json via `themeseed add-site`, and provider keys
# in ~/.themeseed/.env via `themeseed images`. The variables below only exist so
# the repo's own e2e suite can find a disposable CMS.

# --- Ghost integration-test target -------------------------------------------
# A throwaway Ghost instance the e2e suite is allowed to create and delete
# posts in. Never point this at production.
GHOST_TEST_BLOG_ENDPOINT=http://localhost:2368
# Ghost Admin API key, in "<id>:<hex secret>" form.
# Ghost Admin -> Settings -> Integrations -> Add custom integration.
GHOST_TEST_BLOG_KEY=

# Optional: absolute path to the Ghost install's themes directory. When set,
# analyzeTheme() reads the active theme's .hbs sources directly, which is far
# more accurate than probing rendered HTML. Ghost's Admin API /themes/ endpoint
# rejects API-token auth, so there is no remote equivalent.
# GHOST_THEMES_DIR=/path/to/ghost/content/themes
